---
import { getCollection } from "astro:content"
import CommonLayout from "@/layouts/CommonLayout.astro"
import Section from "@/components/layout/Section.astro"
import ExperienceTimeline from "@/components/timeline/ExperienceTimeline.astro"
import Link from "@/components/base/Link.astro"

const all = await getCollection("experience")
const education = all.filter((e) => e.data.category === "education")
const research = all.filter((e) => e.data.category === "research")
const teaching = all.filter((e) => e.data.category === "teaching")
---

<CommonLayout
  title="Currículo"
  description="Formação, experiência em pesquisa e docência."
  breadcrumbs={[{ label: "Currículo", icon: "research" }]}
  prose={false}
  celestial
>
  <p>
    Versão completa e atualizada no{" "}
    <Link href="http://lattes.cnpq.br/1350512148935889" external underline>
      Currículo Lattes
    </Link>
    {" "}e no{" "}
    <Link href="https://orcid.org/0000-0001-8335-9796" external underline>
      ORCID
    </Link>.
  </p>

  <Section title="Formação">
    <ExperienceTimeline entries={education} limit={100} />
  </Section>

  <Section title="Pesquisa">
    <ExperienceTimeline entries={research} limit={100} />
  </Section>

  <Section title="Docência">
    <ExperienceTimeline entries={teaching} limit={100} />
  </Section>
</CommonLayout>
